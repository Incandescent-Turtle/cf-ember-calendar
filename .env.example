# pipeline
FIRMS_MAP_KEY=
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
DATA_DIR=./data
MODIS_MIN_CONF=30
VIIRS_KEEP_CONF=n,h
CAL_START=2013-01-01
CAL_END=2021-12-31
CAL_MIN_MODIS_FCD=200
SNPP_END=2026-11-02
# desktop has 16 GB; raise on the cluster
DUCKDB_MEMORY_LIMIT=10GB
# DuckDB worker threads (empty = all cores)
DUCKDB_THREADS=
# where zip members are extracted temporarily (empty = system temp)
EMBER_TMP_DIR=
# data host upload (scripts/sync_data.sh): Hugging Face dataset repo id; log in with `hf auth login`
HF_DATASET_REPO=
# web (build-time)
# data host base URL; empty = /dev-data (dev middleware: pipeline output first, then web/mock-data)
VITE_DATA_BASE_URL=
# MapLibre style JSON; empty = CARTO Positron (no key)
VITE_BASEMAP_STYLE_URL=
# web (dev only): directory the /dev-data middleware serves first (default ../data/processed)
EMBER_DEV_DATA_DIR=
